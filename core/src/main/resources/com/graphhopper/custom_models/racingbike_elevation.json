// assume constant power of 200W, a weight of 90kg (bike + rider) and a flat speed of 25km/h.
// See bike_elevation.json for how bike_climb_factor treats rough surfaces and pushing the bike.
// TODO: for 200W we need to change the base speed to 28km/h
{
  "speed": [
    { "if":      "average_slope >=   2", "multiply_by": "bike_climb_factor(average_slope, 200, 90, 25)" },
    { "else_if": "average_slope <= -15", "multiply_by": "1.10" },
    { "else_if": "average_slope <=  -9", "multiply_by": "1.60" },
    { "else_if": "average_slope <=  -6", "multiply_by": "1.40" },
    { "else_if": "average_slope <=  -3", "multiply_by": "1.20" }
  ]
}
