// to use this custom model you need to set the following option in the config.yml
// graph.elevation.provider: srtm   # enables elevation
// graph.encoded_values: bike_priority, bike_access, bike_network, roundabout, bike_average_speed, bike_road_access, foot_road_access, average_slope, mtb_rating, hike_rating, country, road_class, ferry_speed
// profiles:
//    - name: bike
//      custom_model_files: [bike.json, bike_avoid_private_node.json]
//
// To reduce turns and enable a more advanced "private-road avoidance" you can enable turn costs:
// profiles:
//    - name: bike
//      turn_costs:
//        vehicle_types: [bicycle]
//        u_turn_costs: 10
//      custom_model_files: [bike.json, bike_avoid_private.json, bike_avoid_turns.json]

{
  // small distance term: avoids long detours, e.g. for small differences in priority
  "distance_influence": 5,
  "parameters": { "max_mtb_rating": 2, "max_hike_rating": 1,
                  "power": { "value": 100, "min": 40, "max": 500 }, "total_weight": { "value": 90, "min": 25, "max": 300 },
                  "air_drag_area": { "value": 0.74, "min": 0.2, "max": 1.2 }, "rolling_resistance": { "value": 0.008, "min": 0.002, "max": 0.03 }, "climb_penalty": { "value": 0.004, "min": 0, "max": 0.02 } },
  "priority": [
    { "if": "true",  "multiply_by": "bike_priority" },
    { "if": "bike_network == INTERNATIONAL || bike_network == NATIONAL",  "multiply_by": "1.4" },
    { "else_if": "bike_network == REGIONAL || bike_network == LOCAL",  "multiply_by": "1.2" },
    { "if": "road_environment == FERRY", "multiply_by": "0.5" },
    { "if": "mtb_rating > p_max_mtb_rating",  "multiply_by": "0" },
    { "if": "hike_rating > p_max_hike_rating",  "multiply_by": "0" },
    { "if": "bike_road_access == NO", "multiply_by": "0" },
    { "if": "!bike_access && (!backward_bike_access || roundabout)",  "multiply_by": "0" },
    { "else_if": "!bike_access && backward_bike_access",  "multiply_by": "0.5" },
    // avoid steep climbs: with constant power a metre of height costs the same time on every slope above 5 %, so the
    // time alone takes the steepest road. Quadratic penalty above 5 %, 0.006: 0.95 at 8 %, 0.85 at 10 %, 0.71 at 12 %, 0.4 at 15 %, floor 0.2
    { "if": "average_slope > 5", "multiply_by": "Math.max(0.2, 1 - p_climb_penalty * (average_slope - 5) * (average_slope - 5))" }
  ],
  "speed": [
    { "if": "road_environment == FERRY", "limit_to": "ferry_speed" },
    { "else": "", "do": [
      { "if": "true", "limit_to": "bike_average_speed" },
      { "if": "!bike_access && backward_bike_access", "limit_to": "6" },
      { "if": "true", "multiply_by": "bike_speed_factor(average_slope, p_power, p_total_weight, p_air_drag_area, p_rolling_resistance, 18)" }
    ]}
  ]
}
