// Assume a constant power of 120W and a total mass of 95kg (bike plus rider). The base speed is the flat speed of
// the bike profile (18km/h) and calibrates the air resistance, which dominates for small inclines
// The bike_climb_factor calculates the speed on inclines from the power balance of a cyclist with the specified
// power and mass (bike plus rider). The base speed is the flat speed of the profile and calibrates the air
// resistance, crr is the rolling resistance coefficient. Where riding gets slower than walking the bike is pushed.
// On descents the speed increases up to vehicle_max_speed, but stays unchanged on steep descents (braking).
{
  "parameters": {
    "power":      { "value": 120,   "min": 40, "max": 1000 },
    "mass":       { "value": 95,    "min": 25, "max": 300 },
    "base_speed": { "value": 18,    "min": 5,  "max": 60 },
    "crr":        { "value": 0.006, "min": 0,  "max": 0.02 },
    "vehicle_max_speed": { "value": 35, "min": 5, "max": 80 }
  },
  "speed": [
    { "if": "average_slope > -15", "multiply_by": "bike_climb_factor(p_power, p_mass, p_base_speed, p_crr)" },
    { "if": "true", "limit_to": "p_vehicle_max_speed" }
  ]
}
