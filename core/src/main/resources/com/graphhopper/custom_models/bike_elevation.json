// The bike_climb_factor calculates the speed on inclines from the power balance of a cyclist with the specified
// power and mass (bike plus rider), the drag area cda (drag coefficient times frontal area in m^2) and the rolling
// resistance coefficient crr. The speed of the profile is the upper limit, e.g. 18km/h on the flat although 120W
// would allow 22km/h. Where riding gets slower than walking the bike is pushed. On descents the speed increases
// up to vehicle_max_speed, but stays unchanged on steep descents (braking). The slower speed already avoids climbs
// proportional to the ascent, the priority penalty per slope percent above 3% (hill_penalty, 0 for none) adds an
// avoidance of steepness, e.g. 0.015 avoids a 10% climb like an edge that takes 12% longer. It is small for the
// rideable range so that the same ascent is not spread over a longer, gentler road (elevation noise would create
// small detours) and grows without a cap into the pushing range to avoid steep shortcuts. Below 3% there is no
// penalty as the speed is limited by the profile there anyway.
{
  "parameters": {
    "power":      { "value": 120,   "min": 40, "max": 1000 },
    "mass":       { "value": 95,    "min": 25, "max": 300 },
    "cda":        { "value": 0.6,   "min": 0.1, "max": 2 },
    "crr":        { "value": 0.01, "min": 0,  "max": 0.02 },
    "vehicle_max_speed": { "value": 45, "min": 5, "max": 80 },
    "hill_penalty": { "value": 0.015, "min": 0, "max": 0.03 }
  },
  "priority": [
    { "if": "average_slope > 3", "multiply_by": "1 - p_hill_penalty * Math.max(average_slope - 3, 0)" }
  ],
  "speed": [
    { "if": "average_slope > -15", "multiply_by": "bike_climb_factor(p_power, p_mass, p_cda, p_crr)" },
    { "if": "true", "limit_to": "p_vehicle_max_speed" }
  ]
}
