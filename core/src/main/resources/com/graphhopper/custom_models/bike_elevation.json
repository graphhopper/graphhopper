// assume constant power of 120W and a weight of 95kg and base speed of approx. 18km/h
{
  "speed": [
    { "if":      "average_slope >= 25",  "limit_to": "1.2" },
    { "else_if": "average_slope >= 15",  "limit_to": "3.0" },
    { "else_if": "average_slope >= 12",  "limit_to": "4.0" },
    { "else_if": "average_slope >=  8",  "multiply_by": "0.28" },
    { "else_if": "average_slope >=  6",  "multiply_by": "0.36" },
    { "else_if": "average_slope >=  4",  "multiply_by": "0.50" },
    { "else_if": "average_slope >=  3",  "multiply_by": "0.60" },

    { "else_if": "average_slope <= -15", "multiply_by": "1.00" },
    { "else_if": "average_slope <=  -9", "multiply_by": "1.50" },
    { "else_if": "average_slope <=  -6", "multiply_by": "1.30" },
    { "else_if": "average_slope <=  -3", "multiply_by": "1.10" }
  ]
}
