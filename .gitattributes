# Set default behaviour, in case users don't have core.autocrlf set.
* text=lf

# Explicitly declare text files we want to always be normalized and converted 
# to native line endings on checkout.
*.sh text

# Retain reproducible matrix evidence while keeping generated data collapsed in PRs.
docs/matrix/*-reconciliation*.json linguist-generated=true
docs/matrix/*-validation.json linguist-generated=true
docs/matrix/*-verification.json linguist-generated=true
docs/matrix/*-samples.csv linguist-generated=true
docs/matrix/*-analysis.json linguist-generated=true
docs/matrix/benchmark-requests.json linguist-generated=true
docs/matrix/regional-failure-replays.jsonl linguist-generated=true
docs/matrix/regional-http-benchmark/*.json linguist-generated=true
docs/matrix/regional-http-benchmark/*-samples.csv linguist-generated=true
docs/matrix/geometry-spot-checks/* linguist-generated=true
docs/matrix/ch-matrix-*.jsonl.gz linguist-generated=true
docs/matrix/ch-matrix-benchmark-*/*.json linguist-generated=true
docs/matrix/ch-matrix-benchmark-*/*.csv linguist-generated=true
docs/matrix/ch-matrix-benchmark-*/*.jsonl.gz linguist-generated=true
docs/matrix/ch-matrix-fixture*.json linguist-generated=true
