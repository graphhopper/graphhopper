// Assume constant power of 200W and a weight of 90kg (bike + rider). For racingbike the base speed is 24km/h,
// see CustomWeightingHelper.createBikeClimbTable.
// See bike_elevation.json for details about bike_climb_factor.
// TODO: for 200W we need to change the base speed to 28km/h in RacingBikeAverageSpeedParser
{
  "speed": [
    { "if":      "average_slope  >   0", "multiply_by": "bike_climb_factor(200, 90)" },
    { "else_if": "average_slope <= -15", "multiply_by": "1.10" },
    { "else_if": "average_slope <=  -9", "multiply_by": "1.60" },
    { "else_if": "average_slope <=  -6", "multiply_by": "1.40" },
    { "else_if": "average_slope <=  -3", "multiply_by": "1.20" }
  ]
}
