// assume constant power of 200W and a weight of 90kg and flat speed 25km/h
// TODO: for 200W we need to change the base speed to 28km/h
{
  "speed": [
    { "if":      "average_slope >= 25",  "limit_to": "3.5" },
    { "else_if": "average_slope >= 15",  "limit_to": "5.0" },
    { "else_if": "average_slope >= 12",  "limit_to": "6.5" },
    { "else_if": "average_slope >=  8",  "multiply_by": "0.36" },
    { "else_if": "average_slope >=  6",  "multiply_by": "0.46" },
    { "else_if": "average_slope >=  4",  "multiply_by": "0.63" },
    { "else_if": "average_slope >=  3",  "multiply_by": "0.75" },

    { "else_if": "average_slope <= -15", "multiply_by": "1.10" },
    { "else_if": "average_slope <=  -9", "multiply_by": "1.60" },
    { "else_if": "average_slope <=  -6", "multiply_by": "1.40" },
    { "else_if": "average_slope <=  -3", "multiply_by": "1.20" }
  ]
}
