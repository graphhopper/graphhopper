// Assume constant power of 120W and a total weight of 95kg. (base speed 18km/h, rolling resistance 0.006)
// According to these values the bike_climb_factor considers the incline. For steep climbs the
// resulting speed is dominated by the power loss from the climb rather than by the surface: a reduced speed
// (rough surface) increases the rolling resistance only slightly (capped), see BikeClimbSpeedTable.
// The base speed calibrates the air resistance, which dominates for small inclines, see BikeClimbSpeedTable.
// The speed never falls below the walking speed at which the cyclist pushes the bike.
{
  "speed": [
    { "if":      "average_slope >=   2", "multiply_by": "bike_climb_factor(120, 95)" },
    { "else_if": "average_slope <= -15", "multiply_by": "1.00" },
    { "else_if": "average_slope <=  -9", "multiply_by": "1.50" },
    { "else_if": "average_slope <=  -6", "multiply_by": "1.30" },
    { "else_if": "average_slope <=  -3", "multiply_by": "1.10" }
  ]
}
